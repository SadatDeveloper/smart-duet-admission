<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeColor="#E5EAF1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- Premium Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1769FF"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Review &amp; Confirm"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Check your application before final submission"
                    android:textColor="#DCE8FF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="#1769FF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="#FFFFFF"
                android:contentDescription="Review" />
        </LinearLayout>

        <!-- Progress strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="#F7F9FC">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5 of 5 steps completed"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY TO SUBMIT"
                android:textColor="#087443"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Scrollable review content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <!-- PERSONAL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PERSONAL INFORMATION"
                    android:textColor="#1769FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:paddingBottom="7dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.38"
                            android:text="Full Name"
                            android:textColor="#64748B"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/reviewName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.62"
                            android:textColor="#1E293B"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EEF5" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.38"
                            android:text="Mobile"
                            android:textColor="#64748B"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/reviewPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.62"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EEF5" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.38"
                            android:text="Email"
                            android:textColor="#64748B"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/reviewEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.62"
                            android:textColor="#1E293B"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ACADEMIC -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ACADEMIC INFORMATION"
                    android:textColor="#1769FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:paddingTop="16dp"
                    android:paddingBottom="7dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.38" android:text="Technology" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/reviewTechnology" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.62" android:textColor="#1E293B" android:textSize="13sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EEF5" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.38" android:text="Passing Year" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/reviewYear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.62" android:textColor="#1E293B" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ADMISSION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ADMISSION CHOICE"
                    android:textColor="#1769FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:paddingTop="16dp"
                    android:paddingBottom="7dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.38" android:text="Department" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/reviewDepartment" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.62" android:textColor="#1769FF" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EEF5" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.38" android:text="Quota" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/reviewQuota" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.62" android:textColor="#1E293B" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- DOCUMENTS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DOCUMENTS"
                    android:textColor="#1769FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:paddingTop="16dp"
                    android:paddingBottom="7dp" />

                <TextView
                    android:id="@+id/reviewDocuments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#087443"
                    android:textSize="12sp"
                    android:background="#F0FDF4"
                    android:padding="12dp"
                    android:lineSpacingExtra="3dp" />

                <!-- PAYMENT -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PAYMENT INFORMATION"
                    android:textColor="#1769FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:paddingTop="16dp"
                    android:paddingBottom="7dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.38" android:text="Payment Method" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/reviewPayment" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.62" android:textColor="#1E293B" android:textSize="13sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EEF5" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.38" android:text="Transaction ID" android:textColor="#64748B" android:textSize="13sp" />
                        <TextView android:id="@+id/reviewTransaction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.62" android:textColor="#1E293B" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Warning -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#FFF7E6"
                    android:padding="12dp"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="!"
                        android:textColor="#B45309"
                        android:textStyle="bold"
                        android:background="#FFE7B3" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="After submitting, your application will be uploaded and saved. Please verify all information carefully."
                        android:textColor="#92400E"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Fixed Action Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5EAF1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReviewEdit"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="0.38"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="#1769FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#EEF5FF"
                    app:cornerRadius="14dp"
                    app:strokeColor="#BFD4FF"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReviewConfirm"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="0.62"
                    android:text="Submit Application"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#1769FF"
                    app:cornerRadius="14dp"
                    app:elevation="2dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
