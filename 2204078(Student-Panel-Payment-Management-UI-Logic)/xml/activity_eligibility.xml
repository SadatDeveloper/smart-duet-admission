<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F7FB">

        <!-- ================= FIXED DASHBOARD HEADER ================= -->
        <LinearLayout
            android:id="@+id/fixedDashboardHeader"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:background="@android:color/white"
            android:elevation="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Menu"
                android:padding="8dp"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/tvPageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eligibility Check"
                    android:textColor="#172033"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPageSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart DUET Admission Management System"
                    android:textColor="#667085"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_profile_circle"
                android:contentDescription="Profile"
                android:padding="10dp"
                android:src="@drawable/ic_profile"
                android:tint="#1769FF" />

        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/fixedDashboardHeader"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingBottom="40dp">




                <!-- ================= HERO ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="5dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/eligibility_gradient"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <!-- Icon -->

                        <TextView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="#35FFFFFF"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Eligibility Check"
                            android:textColor="#FFFFFF"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="Check whether you meet the basic eligibility requirements for DUET undergraduate admission."
                            android:textColor="#EAF1FF"
                            android:textSize="15sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= MAIN CONTENT ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical">


                    <!-- ================= ACADEMIC CARD ================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E5EAF1"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="22dp">

                            <!-- Card Header -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="46dp"
                                    android:layout_height="46dp"
                                    android:background="#EAF2FF"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#1769FF"
                                    android:textSize="23sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="13dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Enter Academic Information"
                                        android:textColor="#172033"
                                        android:textSize="20sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:text="Enter your academic information to check eligibility."
                                        android:textColor="#94A3B8"
                                        android:textSize="13sp" />

                                </LinearLayout>

                            </LinearLayout>


                            <!-- Divider -->

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="18dp"
                                android:background="#E8EDF4" />


                            <!-- ================= SSC GPA ================= -->

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:text="SSC / Equivalent GPA  *"
                                android:textColor="#344054"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                app:boxBackgroundColor="#FFFFFF"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusTopStart="14dp"
                                app:boxStrokeColor="#D8E1EE"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etSscGpa"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:hint="Example: 4.50"
                                    android:inputType="numberDecimal"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:textColor="#172033"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Minimum required: 3.00"
                                android:textColor="#9AAAC0"
                                android:textSize="12sp" />


                            <!-- ================= DIPLOMA GPA ================= -->

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="17dp"
                                android:text="Diploma CGPA  *"
                                android:textColor="#344054"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                app:boxBackgroundColor="#FFFFFF"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusTopStart="14dp"
                                app:boxStrokeColor="#D8E1EE"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etDiplomaGpa"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:hint="Example: 3.50"
                                    android:inputType="numberDecimal"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:textColor="#172033"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Minimum required: 3.00"
                                android:textColor="#9AAAC0"
                                android:textSize="12sp" />


                            <!-- ================= DIPLOMA YEAR ================= -->

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="17dp"
                                android:text="Diploma Passing Year  *"
                                android:textColor="#344054"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                app:boxBackgroundColor="#FFFFFF"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusTopStart="14dp"
                                app:boxStrokeColor="#D8E1EE"
                                app:endIconMode="dropdown_menu"
                                app:hintEnabled="false">

                                <AutoCompleteTextView
                                    android:id="@+id/actDiplomaYear"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:hint="Select Passing Year"
                                    android:inputType="none"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="8dp"
                                    android:textColor="#172033"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>


                            <!-- ================= TECHNOLOGY ================= -->

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="17dp"
                                android:text="Diploma Technology  *"
                                android:textColor="#344054"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                app:boxBackgroundColor="#FFFFFF"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusTopStart="14dp"
                                app:boxStrokeColor="#D8E1EE"
                                app:endIconMode="dropdown_menu"
                                app:hintEnabled="false">

                                <AutoCompleteTextView
                                    android:id="@+id/actTechnology"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:hint="Select Diploma Technology"
                                    android:inputType="none"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="8dp"
                                    android:textColor="#172033"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>


                            <!-- ================= INFO ================= -->

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:background="#F3F6FF"
                                android:padding="14dp"
                                android:text="ⓘ  Please provide accurate academic information. Final eligibility depends on the official DUET admission circular."
                                android:textColor="#60708A"
                                android:textSize="12sp" />


                            <!-- ================= CHECK BUTTON ================= -->

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCheckEligibility"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:layout_marginTop="20dp"
                                android:text="Check Eligibility"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:backgroundTint="#2867E8"
                                app:cornerRadius="15dp"
                                app:icon="@android:drawable/ic_menu_search"
                                app:iconGravity="textStart"
                                app:iconTint="#FFFFFF" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- ================= RESULT CARD ================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/resultCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E5EAF1"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="25dp">

                            <TextView
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:background="#E8F7EF"
                                android:gravity="center"
                                android:text="✓"
                                android:textColor="#138A55"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvResult"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="13dp"
                                android:text="You Are Eligible"
                                android:textColor="#138A55"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvResultMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:gravity="center"
                                android:lineSpacingExtra="3dp"
                                android:textColor="#667085"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnApplyAdmission"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:layout_marginTop="18dp"
                                android:text="Apply for Admission"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:backgroundTint="#138A55"
                                app:cornerRadius="15dp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- ================= BASIC REQUIREMENTS ================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E5EAF1"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="22dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Basic Requirements"
                                android:textColor="#172033"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Minimum requirements"
                                android:textColor="#94A3B8"
                                android:textSize="13sp" />


                            <!-- SSC -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:background="#F8FAFD"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:background="#EAF2FF"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#1769FF"
                                    android:textSize="21sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="13dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="SSC / Equivalent"
                                        android:textColor="#172033"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:text="Minimum GPA 3.00"
                                        android:textColor="#8FA1BA"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </LinearLayout>


                            <!-- Diploma -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="#F8FAFD"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:background="#EAF2FF"
                                    android:gravity="center"
                                    android:text="▣"
                                    android:textColor="#1769FF"
                                    android:textSize="20sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="13dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Diploma"
                                        android:textColor="#172033"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:text="Minimum CGPA 3.00"
                                        android:textColor="#8FA1BA"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </LinearLayout>


                            <!-- Passing Year -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="#F8FAFD"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:background="#EAF2FF"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#1769FF"
                                    android:textSize="21sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="13dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Passing Year"
                                        android:textColor="#172033"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:text="2025 or 2024"
                                        android:textColor="#8FA1BA"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </LinearLayout>


                            <!-- Technology -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="#F8FAFD"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:background="#EAF2FF"
                                    android:gravity="center"
                                    android:text="⚙"
                                    android:textColor="#1769FF"
                                    android:textSize="20sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="13dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Technology"
                                        android:textColor="#172033"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:text="Relevant diploma technology"
                                        android:textColor="#8FA1BA"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- ================= FIXED DASHBOARD FOOTER ================= -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            app:itemIconTint="#173F6B"
            app:itemTextColor="#173F6B"
            app:itemRippleColor="#E3F2FD"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_navigation_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#102A56"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header"
        app:itemIconTint="@android:color/white"
        app:itemTextColor="@android:color/white"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>