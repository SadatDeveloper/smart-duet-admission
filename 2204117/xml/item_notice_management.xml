<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <View
            android:layout_width="4dp"
            android:layout_height="42dp"
            android:background="#1769FF"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNoticeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notice title"
                android:textColor="#1D3557"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvNoticeDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="14 Sep 2026, 01:20 AM"
                android:textColor="#98A2B1"
                android:textSize="10sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvNoticeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:text="PUBLISHED"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Metadata -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvNoticeCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#EAF1FC"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:text="Admission"
            android:textColor="#2459A6"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvNoticePriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#FFF1D8"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:text="Important"
            android:textColor="#A76700"
            android:textSize="10sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/tvNoticeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:text="Notice description"
        android:textColor="#687589"
        android:textSize="13sp"/>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="15dp">

        <Button
            android:id="@+id/btnViewNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="View"
            android:textAllCaps="false"
            android:textColor="#2459A6"
            android:textSize="11sp"
            android:background="#EAF1FC"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnEditNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#2459A6"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnPublishNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="Publish"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#16845D"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnDeleteNotice"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:text="×"
            android:textColor="#D13D4A"
            android:textSize="19sp"
            android:background="#FDECEC"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>
    </LinearLayout>

</LinearLayout>
