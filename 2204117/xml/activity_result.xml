<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- FIXED HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="#FFFFFF"
            android:elevation="5dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:padding="10dp"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Result"
                    android:textColor="#173F6B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Smart DUET Admission Result"
                    android:textColor="#64748B"
                    android:textSize="10sp" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnProfile"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#EEF5FF"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="#1769FF"
                app:strokeWidth="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Profile"
                    android:padding="9dp"
                    android:src="@drawable/ic_profile" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- SCROLLABLE CONTENT -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <!-- ================================================= -->
                <!-- HERO -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="190dp"
                    app:cardBackgroundColor="#2468F2"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <View
                            android:layout_width="220dp"
                            android:layout_height="220dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-120dp"
                            android:layout_marginEnd="-45dp"
                            android:background="@drawable/bg_result_circle" />

                        <View
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="-70dp"
                            android:layout_marginBottom="-75dp"
                            android:background="@drawable/bg_result_circle" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="24dp"
                            android:paddingTop="25dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="24dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                app:cardBackgroundColor="#3B82F6"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="14dp"
                                    android:src="@drawable/ic_result" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="Admission Result"
                                android:textColor="#FFFFFF"
                                android:textSize="27sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Check your official Smart DUET result, merit position and admission status."
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ================================================= -->
                <!-- RESULT STATUS - DYNAMIC -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResultStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:minHeight="210dp"
                    app:cardBackgroundColor="#F4FFF9"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#A7E5C5"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-70dp"
                            android:layout_marginEnd="-55dp"
                            android:background="@drawable/bg_result_success_circle" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="18dp"
                            android:paddingTop="24dp"
                            android:paddingEnd="18dp"
                            android:paddingBottom="24dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                app:cardBackgroundColor="#D1FAE5"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/tvResultIcon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#159447"
                                    android:textSize="36sp"
                                    android:textStyle="bold" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvResultTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="center"
                                android:text="Loading Result..."
                                android:textColor="#159447"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvResultMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="Loading your result from Firebase..."
                                android:textColor="#475569"
                                android:textSize="14sp"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ================================================= -->
                <!-- APPLICATION INFORMATION - FIREBASE -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardApplicationInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                app:cardBackgroundColor="#EAF2FF"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="▣"
                                    android:textColor="#1769FF"
                                    android:textSize="20sp" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Application Information"
                                android:textColor="#172033"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:background="#E2E8F0" />

                        <!-- Row 1 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="78dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_result_info_box"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="APPLICATION NUMBER"
                                    android:textColor="#64748B"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvApplicationNumber"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:textColor="#1E293B"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <Space
                                android:layout_width="10dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="78dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_result_info_box"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="APPLICANT NAME"
                                    android:textColor="#64748B"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvApplicantName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:textColor="#1E293B"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Row 2 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="78dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_result_info_box"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="FATHER'S NAME"
                                    android:textColor="#64748B"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvFatherName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:textColor="#1E293B"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <Space
                                android:layout_width="10dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="78dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_result_info_box"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="DEPARTMENT"
                                    android:textColor="#64748B"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDepartment"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:textColor="#1E293B"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Row 3 -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="78dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_result_info_box"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="DIPLOMA TECHNOLOGY"
                                    android:textColor="#64748B"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDiplomaTechnology"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:textColor="#1E293B"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ================================================= -->
                <!-- MERIT POSITION - SHOWN ONLY AFTER PUBLISH -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMeritPosition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                app:cardBackgroundColor="#EAF2FF"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="▥"
                                    android:textColor="#1769FF"
                                    android:textSize="20sp" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Merit Position"
                                android:textColor="#172033"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:background="#E2E8F0" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_result_merit">

                            <View
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom|start"
                                android:layout_marginStart="-45dp"
                                android:layout_marginBottom="-45dp"
                                android:background="@drawable/bg_result_merit_circle" />

                            <View
                                android:layout_width="105dp"
                                android:layout_height="105dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="-45dp"
                                android:layout_marginEnd="-40dp"
                                android:background="@drawable/bg_result_merit_circle" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="YOUR MERIT POSITION"
                                    android:textColor="#64748B"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMeritPosition"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="—"
                                    android:textColor="#1769FF"
                                    android:textSize="48sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DUET Admission Merit Ranking"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </FrameLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ================================================= -->
                <!-- RESULT DETAILS - FULLY DYNAMIC -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResultDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="5dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                app:cardBackgroundColor="#EAF2FF"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="ⓘ"
                                    android:textColor="#1769FF"
                                    android:textSize="20sp" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Result Details"
                                android:textColor="#172033"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:background="#E2E8F0" />

                        <!-- Status + Published -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="78dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_result_info_box"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="RESULT STATUS"
                                    android:textColor="#64748B"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvResultStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:text="PUBLISHED"
                                    android:textColor="#1E293B"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <Space
                                android:layout_width="10dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="78dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_result_info_box"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="RESULT PUBLISHED"
                                    android:textColor="#64748B"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvResultPublished"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:text="Published"
                                    android:textColor="#1E293B"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Marks + Total Marks -->

                        <LinearLayout
                            android:id="@+id/rowMarksTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="78dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_result_info_box"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="OBTAINED MARKS"
                                    android:textColor="#64748B"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMarks"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="—"
                                    android:textColor="#1E293B"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <Space
                                android:layout_width="10dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="78dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_result_info_box"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="TOTAL MARKS"
                                    android:textColor="#64748B"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvTotalMarks"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="—"
                                    android:textColor="#1E293B"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Remarks -->

                        <LinearLayout
                            android:id="@+id/rowRemarks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_result_info_box"
                            android:orientation="vertical"
                            android:padding="13dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="REMARKS"
                                android:textColor="#64748B"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRemarks"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="—"
                                android:textColor="#1E293B"
                                android:textSize="13sp"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

        <!-- FIXED FOOTER -->

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            app:itemIconTint="#173F6B"
            app:itemTextColor="#173F6B"
            app:itemRippleColor="#E3F2FD"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_navigation_menu" />

    </LinearLayout>

    <!-- DARK BLUE DRAWER -->

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="285dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0B2340"
        android:elevation="16dp"
        android:fitsSystemWindows="true"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:headerLayout="@layout/drawer_header"
        app:itemHorizontalPadding="20dp"
        app:itemIconTint="@android:color/white"
        app:itemTextColor="@android:color/white"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
