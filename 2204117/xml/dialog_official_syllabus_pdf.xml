<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvPdfTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Official DUET Syllabus"
            android:textColor="#173F6B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPdfZoom"
            android:layout_width="52dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="100%"
            android:textColor="#667085"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPdfZoomOut"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#173F6B"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPdfZoomIn"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#173F6B"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPdfDownload"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="↓"
            android:textColor="#155EEF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPdfClose"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#667085"
            android:textSize="27sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#EEF2F7">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:id="@+id/pdfPagesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp" />
            </HorizontalScrollView>
        </ScrollView>

        <ProgressBar
            android:id="@+id/pdfProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center" />
    </FrameLayout>

</LinearLayout>
