<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="#FFFFFF"
            android:elevation="5dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:padding="10dp"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admit Card"
                    android:textColor="#173F6B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="DUET Admission Test Admit Card"
                    android:textColor="#64748B"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnProfile"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#EEF5FF"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="#1769FF"
                app:strokeWidth="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Profile"
                    android:padding="9dp"
                    android:src="@drawable/ic_profile" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/admitCardPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="2dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#D1D5DB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="16dp">

                        <ImageView
                            android:id="@+id/ivDuetLogo"
                            android:layout_width="75dp"
                            android:layout_height="75dp"
                            android:layout_gravity="center_horizontal"
                            android:contentDescription="DUET Logo"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:gravity="center"
                            android:text="Dhaka University of Engineering &amp; Technology"
                            android:textColor="#073D78"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            android:text="Gazipur, Bangladesh"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="17dp"
                            android:gravity="center"
                            android:text="ADMISSION TEST 2026 — ADMIT CARD"
                            android:textColor="#073D78"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginTop="18dp"
                            android:background="#073D78" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="10dp">
                                    <TextView
                                        android:layout_width="96dp"
                                        android:layout_height="wrap_content"
                                        android:text="Applicant Name"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:id="@+id/tvApplicantName"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="10dp">
                                    <TextView
                                        android:layout_width="96dp"
                                        android:layout_height="wrap_content"
                                        android:text="Father's Name"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:id="@+id/tvFatherName"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="10dp">
                                    <TextView
                                        android:layout_width="96dp"
                                        android:layout_height="wrap_content"
                                        android:text="Application No"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:id="@+id/tvApplicationNo"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="10dp">
                                    <TextView
                                        android:layout_width="96dp"
                                        android:layout_height="wrap_content"
                                        android:text="Admit Card No"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:id="@+id/tvAdmitCardNo"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="10dp">
                                    <TextView
                                        android:layout_width="96dp"
                                        android:layout_height="wrap_content"
                                        android:text="Department"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:id="@+id/tvDepartment"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <TextView
                                        android:layout_width="96dp"
                                        android:layout_height="wrap_content"
                                        android:text="Identity Number"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:id="@+id/tvIdentityNumber"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="#1E293B"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/ivApplicantPhoto"
                                android:layout_width="88dp"
                                android:layout_height="112dp"
                                android:layout_marginStart="10dp"
                                android:background="#E2E8F0"
                                android:contentDescription="Applicant Photo"
                                android:scaleType="centerCrop" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="24dp"
                            android:background="#EDF4FF"
                            android:gravity="center_vertical">
                            <View
                                android:layout_width="4dp"
                                android:layout_height="match_parent"
                                android:background="#123F75" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="▣  Examination Information"
                                android:textColor="#073D78"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:stretchColumns="*">

                            <TableRow>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="70dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_admit_table_cell"
                                    android:orientation="vertical"
                                    android:padding="10dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Exam Date"
                                        android:textColor="#64748B"
                                        android:textSize="10sp" />
                                    <TextView
                                        android:id="@+id/tvExamDate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:textColor="#1E293B"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="70dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_admit_table_cell"
                                    android:orientation="vertical"
                                    android:padding="10dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Shift / Time"
                                        android:textColor="#64748B"
                                        android:textSize="10sp" />
                                    <TextView
                                        android:id="@+id/tvExamTime"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:textColor="#1E293B"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </TableRow>

                            <TableRow>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="70dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_admit_table_cell"
                                    android:orientation="vertical"
                                    android:padding="10dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Examination Center"
                                        android:textColor="#64748B"
                                        android:textSize="10sp" />
                                    <TextView
                                        android:id="@+id/tvExamCenter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:textColor="#1E293B"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="70dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_admit_table_cell"
                                    android:orientation="vertical"
                                    android:padding="10dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Department"
                                        android:textColor="#64748B"
                                        android:textSize="10sp" />
                                    <TextView
                                        android:id="@+id/tvExamDepartment"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:textColor="#1E293B"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </TableRow>
                        </TableLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="95dp"
                            android:layout_marginTop="15dp"
                            android:background="@drawable/bg_admit_seat"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="YOUR SEAT NUMBER"
                                android:textColor="#1E293B"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvSeatNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#087A4B"
                                android:textSize="27sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="17dp"
                            android:background="#EDF4FF"
                            android:gravity="center_vertical">
                            <View
                                android:layout_width="4dp"
                                android:layout_height="match_parent"
                                android:background="#123F75" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="Important Instructions"
                                android:textColor="#073D78"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvInstructions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="11dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="#334155"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <ImageView
                                    android:id="@+id/ivApplicantSignature"
                                    android:layout_width="120dp"
                                    android:layout_height="36dp"
                                    android:contentDescription="Applicant Signature"
                                    android:scaleType="fitCenter" />
                                <View
                                    android:layout_width="120dp"
                                    android:layout_height="1dp"
                                    android:background="#1E293B" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="Applicant's Signature"
                                    android:textColor="#334155"
                                    android:textSize="8sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <ImageView
                                    android:id="@+id/ivAuthorizedSignature"
                                    android:layout_width="120dp"
                                    android:layout_height="36dp"
                                    android:contentDescription="Authorized Signature"
                                    android:scaleType="fitCenter" />
                                <View
                                    android:layout_width="120dp"
                                    android:layout_height="1dp"
                                    android:background="#1E293B" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="Authorized Signature"
                                    android:textColor="#334155"
                                    android:textSize="8sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- ================= DYNAMIC PDF FOOTER ================= -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:orientation="vertical">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#D1D5DB" />

                            <TextView
                                android:id="@+id/tvAdmitCardFooter"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:gravity="center"
                                android:text="Smart DUET Admission Management System | DUET Admission Test"
                                android:textColor="#64748B"
                                android:textSize="7sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="2dp"
                                android:layout_marginTop="8dp"
                                android:background="#073D78" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrintAdmitCard"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_marginBottom="20dp"
                    android:text="Print Admit Card"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:backgroundTint="#1769FF"
                    app:cornerRadius="13dp" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            app:itemIconTint="#173F6B"
            app:itemTextColor="#173F6B"
            app:itemRippleColor="#E3F2FD"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_navigation_menu" />
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="285dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0B2340"
        android:elevation="16dp"
        android:fitsSystemWindows="true"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:headerLayout="@layout/drawer_header"
        app:itemHorizontalPadding="20dp"
        app:itemIconTint="@android:color/white"
        app:itemTextColor="@android:color/white"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
