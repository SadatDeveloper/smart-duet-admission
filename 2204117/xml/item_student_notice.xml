<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_student_notice_card"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/noticeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <View
                    android:layout_width="4dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_student_notice_accent"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStudentNoticeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notice title"
                        android:textColor="#1D3557"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/tvStudentNoticeDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="14 Sep 2026"
                        android:textColor="#98A2B1"
                        android:textSize="10sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="OFFICIAL"
                    android:textColor="#16845D"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_student_notice_official"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp">

                <TextView
                    android:id="@+id/tvStudentNoticeCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="Admission"
                    android:textColor="#2459A6"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_student_notice_category"/>

                <TextView
                    android:id="@+id/tvStudentNoticePriority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="Important"
                    android:textColor="#A76700"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_student_notice_priority"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStudentNoticeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="Notice description"
                android:textColor="#687589"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/btnStudentNoticeView"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="View Notice"
                android:textColor="#1769FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_student_notice_view"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
